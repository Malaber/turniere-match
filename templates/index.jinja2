<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Turnie.re Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="{{ url_for('static', filename='pure.css') }}" integrity="sha256-fPXvMqJjeydW056U7AUM/dp5L+sRz0xPK0Mx3p20nkI=">
    <!--<script src="{{ url_for('static', filename='socket.io.js') }}"></script>-->
    <style>
        .main-table {
            border-width: 0 !important;
            width: 100%;
        }
    </style>
</head>

<body>
<!-- Timer -->
<h1>Timer</h1>
<p>Current Timer End: <span id="timer">{{ timer }}</span></p>
<form class="pure-form" action="{{ url_for('set_timer') }}" method="POST">
    <fieldset>
        <label for="end_time">New End Time:</label>
        <input type="datetime-local" id="end_time" name="end_time" required>
        <button type="submit" class="pure-button pure-button-primary">Set Timer</button>
    </fieldset>
</form>
<form class="pure-form" action="{{ url_for('set_timer_seconds') }}" method="POST">
    <fieldset>
        <label for="timer_end_minutes">Duration (minutes):</label>
        <input type="range" id="timer_end_minutes_slider" min="0" max="120" value="20" oninput="updateDuration()">
        <span id="timer_end_minutes_display">20</span> minutes
        <br>
        <label for="timer_end_seconds">Duration (seconds):</label>
        <input type="range" id="timer_end_seconds_slider" min="0" max="60" value="0" oninput="updateDuration()">
        <span id="timer_end_seconds_display">0</span> seconds
        <input type="hidden" id="timer_end_seconds" name="timer_end_seconds" value="1200">
        <button type="submit" class="pure-button pure-button-primary">Set Timer</button>
    </fieldset>
</form>
<!-- Matches -->
{% for stage in stages %}
    {% set sid = stage['level'] %}
    <h1>
        {% if stage.group %}
            Gruppe {{ sid }}
        {% else %}
        {% endif %}
        {% if not stage.group or loop.first %}
            <form class="pure-form" action="{{ url_for('next_stage_matches', sid='group' if stage.group else stage['id']) }}" method="POST">
                <fieldset>
                    <label for="sure-{{ sid }}">
                        <input id="sure-{{ sid }}" type="checkbox" required> Sicher?
                    </label>
                    <label for="sure2-{{ sid }}">
                        <input id="sure2-{{ sid }}" type="checkbox" required> Sicher?
                    </label>
                    <button type="submit" class="pure-button pure-button-primary">Nächste Matches starten</button>
                </fieldset>
            </form>
            {% if stage.group %}
                <form class="pure-form" action="{{ url_for('stop_group_stage', sid=stage['id']) }}" method="POST">
                    <fieldset>
                        <label for="sure3-{{ sid }}">
                            <input id="sure3-{{ sid }}" type="checkbox" required> Sicher?
                        </label>
                        <button type="submit" class="pure-button pure-button-primary">Gruppenphase beenden</button>
                    </fieldset>
                </form>
            {% endif %}
        {% endif %}
    </h1>
    <table class="pure-table main-table">
        <tr>
            {% for match in stage.matches %}
                {% set matchscores = match['match_scores']|sort(attribute='id') %}
                {% set matchscore1 = matchscores[0] %}
                {% set matchscore2 = matchscores[1] %}
                {% set name1 = matchscore1['team']['name'] %}
                {% set name2 = matchscore2['team']['name'] %}
                {% set score1 = matchscore1['points'] %}
                {% set score2 = matchscore2['points'] %}
                <td style="background-color: {% if match.state == 'not_started' %}gray{% elif match.state == 'in_progress' %}yellow{% else %}lime{% endif %}">
                    <form class="pure-form pure-form-stacked" action="{{ url_for('submit_match_result', mid=match.id) }}"
                          method="POST" id="match-{{ match.id }}">
                        <input type="hidden" name="matchscore1" value="{{ matchscore1['id'] }}">
                        <input type="hidden" name="matchscore2" value="{{ matchscore2['id'] }}">
                        <fieldset>
                            <label for="score1-{{ match.id }}">{{ name1 }}</label>
                            <input name="score1" id="score1-{{ match.id }}" type="number" value="{{ score1 }}">

                            <label for="score2-{{ match.id }}">{{ name2 }}</label>
                            <input name="score2" id="score2-{{ match.id }}" type="number" value="{{ score2 }}">

                            <label for="isLive-{{ match.id }}" class="pure-checkbox">
                                Live <input name="isLive" id="isLive-{{ match.id }}" type="checkbox" {% if match.state == 'in_progress' %}checked{% endif %}>
                            </label>
                            <button type="submit" class="pure-button pure-button-primary" {% if match.state != 'in_progress' %}disabled{% endif %}>Abschicken</button>
                        </fieldset>
                    </form>
                </td>
                {% if (loop.index % 6) == 0 %}</tr>
                    <tr>{% endif %}
            {% endfor %}
            </tr>
    </table>
{% endfor %}

<script>
    function updateDuration() {
        const minutes = document.getElementById('timer_end_minutes_slider').value;
        const seconds = document.getElementById('timer_end_seconds_slider').value;
        document.getElementById('timer_end_minutes_display').innerText = minutes;
        document.getElementById('timer_end_seconds_display').innerText = seconds;
        document.getElementById('timer_end_seconds').value = (parseInt(minutes) * 60) + parseInt(seconds);
    }

    function startTimer(endTime) {
        function updateTimer() {
            const now = new Date().getTime();
            const distance = endTime - now;

            if (distance < 0) {
                document.getElementById('timer').innerText = "EXPIRED";
                clearInterval(timerInterval);
                return;
            }

            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById('timer').innerText = `${hours}h ${minutes}m ${seconds}s`;
        }

        updateTimer();
        const timerInterval = setInterval(updateTimer, 1000);
    }

    const timerEnd = new Date("{{ timer }}").getTime();
    startTimer(timerEnd);
</script>
<script src="{{ url_for('static', filename='main.js') }}"></script>
</body>

</html>