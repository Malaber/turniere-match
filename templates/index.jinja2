<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Turnie.re Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="{{ url_for('static', filename='pure.css') }}" integrity="sha256-fPXvMqJjeydW056U7AUM/dp5L+sRz0xPK0Mx3p20nkI=">
    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>

<body>
<div class="navbar">
    <h1 class="navbar__title">Turniere - Admin</h1>
    <div class="navbar__timer" id="navbarTimer"></div>
    <div class="search-wrapper">
        <input type="text" id="teamSearch" onkeyup="filterTeams()" placeholder="Search for teams.. (⌘+k)">
        <button class="navbar__delete-button" id="clearSearch" onclick="clearSearchInput()">✕</button>
    </div>
</div>
{% include 'timer.jinja2' %}
<hr>
<details>
    <summary class="pure-button">Manage Next Matches</summary>
    {% for stage in stages %}
        {% if not stage.group or loop.first %} {# stages is an array of all groups and stages, this runs once for the group stage and once for every playoff stage #}
            {% with url=url_for('next_stage_matches', sid='group' if stage.group else stage['id']), button_text="Nächste Matches starten" %}
                {% include "you_sure_form.jinja2" %}
            {% endwith %}
            {% if stage.group %}
            {% with url=url_for('stop_group_stage', sid=stage['id']), button_text="Beenden" %}
                {% include "you_sure_form.jinja2" %}
            {% endwith %}
        {% endif %}
    {% endif %}
{% endfor %}
</details>
<hr>
{% for stage in stages %}
    <div class="stage">
        {% set sid = stage['level'] %}
        <div class="stage__header">
            <h1>
                {{ stage.name }}
            </h1>
            {% if stage.group %}
                <button
                    type="button"
                    class="pure-button stage__table-button"
                    data-group-id="{{ stage.group_id }}"
                    data-group-name="{{ stage.name }}"
                    onclick="openGroupTableModal(this)"
                >
                    Tabelle
                </button>
            {% endif %}
        </div>
        <table class="pure-table pure-table-bordered main-table">
            {% for match_row in stage.matches|batch(6) %}
                <tr>
                    {% for match in match_row %}
                        {% include "match_table_match.jinja2" %}
                    {% endfor %}
                </tr>
            {% endfor %}
        </table>
        {% if not loop.last %}
            <hr>
        {% endif %}
    </div>
{% endfor %}

<div id="groupTableModal" class="group-table-modal" hidden>
    <div class="group-table-modal__backdrop" onclick="closeGroupTableModal()"></div>
    <div
        class="group-table-modal__dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="groupTableModalTitle"
    >
        <div class="group-table-modal__header">
            <h2 id="groupTableModalTitle">Tabelle</h2>
            <button type="button" class="pure-button group-table-modal__close" onclick="closeGroupTableModal()">Schließen</button>
        </div>
        <div id="groupTableModalStatus" class="group-table-modal__status" hidden></div>
        <table class="pure-table pure-table-striped group-table-modal__table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Team</th>
                    <th>Punkte</th>
                    <th>Differenz</th>
                    <th>Geworfen</th>
                </tr>
            </thead>
            <tbody id="groupTableModalBody">
            </tbody>
        </table>
    </div>
</div>

<script src="{{ url_for('static', filename='main.js') }}"></script>
</body>

</html>
