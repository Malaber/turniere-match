<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Turnie.re Teams</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="{{ url_for('static', filename='pure.css') }}" integrity="sha256-fPXvMqJjeydW056U7AUM/dp5L+sRz0xPK0Mx3p20nkI=">
    <style>
        .main-table {
          border-width: 0 !important;
          width: 100%;
        }
    </style>
</head>
<body>
    {% for team in teams %}
    {% set tid = team['id'] %}
    <form class="pure-form" action="{{ url_for('update_team_name', tid=tid) }}" method="POST">
    {{ team.id }} - {{ team.name }}
    <label for="name-{{ tid }}">
        <input id="name-{{ tid }}" name="name" type="text" placeholder="{{ team.name }}" required>
    </label>
    <button type="submit" class="pure-button pure-button-primary">Ändern</button>
    </form>
    {% endfor %}
</body>
